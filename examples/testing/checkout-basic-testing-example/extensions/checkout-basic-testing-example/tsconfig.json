{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "target": "ES2020",
    "checkJs": true,
    "allowJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "preact": ["../../node_modules/preact"],
      "preact/*": ["../../node_modules/preact/*"]
    }
  },
  "include": ["./src", "./tests", "./shopify.d.ts"]
}
