{
  "name": "@shopify/ui-extensions-tester",
  "version": "2026.4.0-rc.1",
  "main": "index.js",
  "module": "index.mjs",
  "esnext": "index.esnext",
  "types": "./build/ts/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/ts/index.d.ts",
      "esnext": "./index.esnext",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./checkout": {
      "types": "./build/ts/checkout/index.d.ts",
      "esnext": "./checkout.esnext",
      "import": "./checkout.mjs",
      "require": "./checkout.js"
    }
  },
  "typesVersions": {
    "*": {
      "checkout": [
        "./build/ts/checkout/index.d.ts"
      ]
    }
  },
  "license": "MIT",
  "dependencies": {
    "@shopify/ui-extensions": "2026.4.0-rc.1"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^4.9.0"
  },
  "publishConfig": {
    "access": "public",
    "@shopify:registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Shopify/ui-extensions.git",
    "directory": "packages/ui-extensions-tester"
  },
  "files": [
    "build",
    "src",
    "index.*",
    "checkout.*",
    "README.md"
  ]
}
