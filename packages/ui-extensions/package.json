{
  "name": "@shopify/ui-extensions",
  "version": "2025.7.0",
  "scripts": {
    "docs:admin": "bash ./docs/surfaces/admin/build-docs.sh",
    "docs:ab": "bash ./docs/surfaces/admin/build-ab-docs.sh",
    "docs:checkout": "bash ./docs/surfaces/checkout/build-docs.sh",
    "docs:point-of-sale": "bash ./docs/surfaces/point-of-sale/build-docs.sh",
    "docs:customer-account": "bash ./docs/surfaces/customer-account/build-docs.sh"
  },
  "main": "index.js",
  "module": "index.mjs",
  "esnext": "index.esnext",
  "types": "./build/ts/index.d.ts",
  "typesVersions": {
    "*": {
      "admin": [
        "./build/ts/surfaces/admin.d.ts"
      ],
      "admin.*": [
        "./build/ts/surfaces/admin/targets/admin.*"
      ],
      "checkout": [
        "./build/ts/surfaces/checkout.d.ts"
      ],
      "checkout.*": [
        "./build/ts/surfaces/checkout/targets/checkout.*"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./build/ts/index.d.ts",
      "esnext": "./index.esnext",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./admin": {
      "types": "./build/ts/surfaces/admin.d.ts",
      "esnext": "./build/esnext/surfaces/admin.esnext",
      "import": "./build/esm/surfaces/admin.mjs",
      "require": "./build/cjs/surfaces/admin.js"
    },
    "./admin.*": {
      "types": "./build/ts/surfaces/admin/targets/admin.*.d.ts"
    },
    "./checkout": {
      "types": "./build/ts/surfaces/checkout.d.ts",
      "esnext": "./build/esnext/surfaces/checkout.esnext",
      "import": "./build/esm/surfaces/checkout.mjs",
      "require": "./build/cjs/surfaces/checkout.js"
    },
    "./checkout.*": {
      "types": "./build/ts/surfaces/checkout/targets/checkout.*.d.ts"
    },
    "./preact": {
      "types": "./build/ts/preact.d.ts",
      "esnext": "./build/esnext/preact.esnext",
      "import": "./build/esm/preact.mjs",
      "require": "./build/cjs/preact.js"
    }
  },
  "license": "MIT",
  "sideEffects": [
    "./build/esnext/preact.esnext",
    "./build/esm/preact.mjs",
    "./build/cjs/preact.js"
  ],
  "devDependencies": {
    "@shopify/generate-docs": "0.16.4",
    "typescript": "^4.9.0"
  },
  "optionalDependencies": {
    "@preact/signals": "*"
  },
  "publishConfig": {
    "access": "public",
    "@shopify:registry": "https://registry.npmjs.org/"
  },
  "files": [
    "build",
    "src",
    "!*.doc.ts",
    "index.*",
    "README.md"
  ],
  "eslintConfig": {
    "rules": {
      "@shopify/strict-component-boundaries": "off"
    }
  },
  "dependencies": {
    "ts-morph": "^25.0.1"
  }
}
